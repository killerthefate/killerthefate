#include <iostream>
#include <string>
#include <vector>
#include <list>
#include <stack>
#include <queue>
#include <deque>
#include <set>
#include <map>
using namespace std;

int main() {

vector<int>v;
v.push_back(10);
v.push_back(20);
v.push_back(30);
v.pop_back();
//v.empty();
//v.clear();
cout<<"VECTOR\n";
for(auto x:v)
cout<<x<<" ";

list<int>l;
l.push_back(10);
l.push_back(20);
l.push_front(30);
l.push_front(40);
l.pop_back();
l.pop_front();
//l.empty();
//l.clear();
cout<<"\n\nLIST\n";
for(auto x:l)
cout<<x<<" ";

stack<int>s;
s.push(10);
s.push(20);
s.push(30);
s.push(40);
s.pop();
//s.top();
//s.empty();
//s.clear();
cout<<"\n\nSTACK\n";
s.push(20);
cout<<s.top();

queue<int>q;
q.push(10);
q.push(20);
q.push(30);
q.push(40);
cout<<"\n\nQUEUE\n";
q.pop();
cout<<q.front();


deque<int>d;
d.push_front(10);
d.push_back(20);
d.push_front(30);
cout<<"\n\nDEQUE\n";
for(auto x:d)
cout<<x<<" ";

set<int>se;
se.insert(10);
se.insert(20);
se.insert(30);
se.insert(40);
//se.count();
cout<<"\n\nSET\n";
for(auto x:se)
cout<<x<<" ";

map<int,string>m;
m[1]="aman";
m[2]="rahul";
m[3]="riya";
cout<<"\n\nMAP\n";
for(auto x:m)
cout<<x.first<<" "<<x.second;

    return 0;
}
