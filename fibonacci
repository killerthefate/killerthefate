#include <stdio.h>

int main() {
    int i,n,next,first=0,second=1;
    printf("By using fibonacci enter your number to add-->");
    scanf("%d",&n);
    for(i=1;i<=n;i++){
        next=first+second;
        printf("%d+%d=%d\n",first,second,next);
        first=second;
        second=next;
        }
return 0;
}
