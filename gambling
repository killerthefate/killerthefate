#include <iostream>
#include <string>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    int x,i,mon;
    srand(time(0));
    int gam = rand() % 101;
    cout<<"================================="<<endl;
    cout<<"||          GAMBALING          ||"<<endl;
    cout<<"================================="<<endl<<endl;
    cout<<"100=5 attempts\n500=10 attempts\n1000=30 attempts\n1500=50 attempts\n2000=100 attempts\n\n";
    cout<<"Enter your money-->";
    cin>>mon;
    cout<<"you only have "<<mon<<" attempts\n";
    for(i=1;i<=mon;i++){
        cout<<endl<<"attempts "<<i<<endl;
        cout<<"Enter number-->";
        cin>>x;
        if(x==gam){
            cout<<"\""<<gam<<"\"you win in"<<i<<" attempts";
            return 0;
        }else if(x<gam){
            cout<<x<<" is too low\n";
        }else if(x>gam){
            cout<<x<<" is too high\n";
        }

    }
    cout<<"\ngame over";

    return 0;
}
